TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=@viginotealerts            # or -100xxxxxxxxxxxx

# Regions to poll (comma-separated):
REGIONS=GLOBAL,MIDDLE_EAST,EUROPE,ASIA,WEST_EAST_AFRICA,SOUTHERN_AFRICA,SOUTH_AMERICA
CUSTOM_FEEDS=

POLL_LIMIT=25
MAX_ALERTS_PER_RUN=6
MAX_ALERTS_PER_DAY=18
MIN_GAP_SECONDS=90
QUIET_HOURS_UTC=                            # e.g. 22-06

# Per-region minimum to encourage diversity (best-effort)
MIN_PER_REGION=1

# De-dup within 24h: max distinct sources per story cluster
MAX_PER_CLUSTER=2
SIM_THRESHOLD=86

USER_AGENT=VigiNoteAlertsBot/1.0 (+https://viginote.com)
DB_PATH=./osint.db

# Optional (leave blank to use extractive fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
POLL_INTERVAL=900   # 900s = 15 min. Set 0 to run once (use cron instead)

# ── South Africa edition (EDITION=SA) ──────────────────────────────────────
EDITION=SA
ADMIN_SECRET=change-me-long-random      # required for /za/admin and ops endpoints (fail-closed if unset)
PUBLIC_BASE_URL=https://your-domain.example
SA_POLL_INTERVAL=900
SA_SITE_AUTOPUBLISH=0                   # 1 = auto-publish official (tier 3) items to the SITE only
SA_MIN_SCORE=2
SA_INSTAGRAM_HANDLE=@viginote.za
SA_TELEGRAM_CHAT_ID=                    # optional: ping this chat when critical/high items await review
DB_PATH=/data/viginote_v6.db
