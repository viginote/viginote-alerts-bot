<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VigiNote Client Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--navy:#0f1f5c;--navy2:#1a2f6e;--paper:#f7f8fc;--white:#fff;--ink:#0a0f1e;--ink2:#1e2840;--mist:#8a9ab5;--border:#d0d8e8;--blue-pale:#e8edf9;--steel:#4a6080;--low:#1a7a4a;--low-bg:#e8f5ee;--medium:#b07d00;--medium-bg:#fff8e1;--high:#c04a00;--high-bg:#fff0e8;--critical:#a01515;--critical-bg:#fde8e8;--extreme:#5a0080;--extreme-bg:#f5e8ff}
html{-webkit-font-smoothing:antialiased}
body{font-family:'DM Sans',sans-serif;background:var(--paper);color:var(--ink);min-height:100vh}
.topbar{background:var(--navy);height:52px;display:flex;align-items:center;padding:0 24px;gap:14px;position:sticky;top:0;z-index:100}
.topbar-brand{display:flex;align-items:center;gap:9px;margin-right:auto;text-decoration:none}
.brand-text{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:600;color:#fff;letter-spacing:0.5px}
.brand-sub{font-size:9px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:rgba(160,180,232,0.65);display:block;margin-top:-2px}
.client-badge{font-size:11px;font-weight:600;color:rgba(255,255,255,0.6);background:rgba(255,255,255,0.08);padding:4px 10px;border-radius:4px;border:1px solid rgba(255,255,255,0.12)}
.nav-link{font-size:12px;font-weight:500;color:rgba(255,255,255,0.5);text-decoration:none;padding:5px 12px;border-radius:4px;transition:all 0.15s}
.nav-link:hover{color:#fff;background:rgba(255,255,255,0.08)}
.portal-body{max-width:1100px;margin:0 auto;padding:28px 24px 80px}
.stats-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:28px}
.stat-card{background:var(--white);border:1px solid var(--border);border-radius:8px;padding:16px 18px}
.sc-label{font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--mist);margin-bottom:6px}
.sc-val{font-size:26px;font-weight:700;color:var(--navy2);line-height:1}
.sc-sub{font-size:11px;color:var(--mist);margin-top:4px}
.section{margin-bottom:28px}
.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;padding-bottom:10px;border-bottom:1.5px solid var(--border)}
.section-title{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:600;color:var(--ink)}
.section-meta{font-size:11px;color:var(--mist)}
.traj-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px}
.traj-card{background:var(--white);border:1px solid var(--border);border-radius:8px;padding:14px 16px}
.tc-region{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--steel);margin-bottom:8px}
.tc-traj{font-size:15px;font-weight:700;margin-bottom:6px;display:flex;align-items:center;gap:7px}
.traj-IMPROVING{color:var(--low)}.traj-STABLE{color:var(--steel)}.traj-DETERIORATING{color:var(--critical)}
.tc-stats{display:flex;gap:16px;font-size:11px;color:var(--mist)}
.diversity-wrap{background:var(--white);border:1px solid var(--border);border-radius:8px;padding:18px 20px}
.div-bar{height:10px;border-radius:5px;overflow:hidden;display:flex;margin:12px 0}
.div-seg{height:100%}
.div-seg.local{background:#1a7a4a}.div-seg.regional{background:#2d5be3}.div-seg.wire{background:#d0d8e8}
.div-legend{display:flex;gap:16px;flex-wrap:wrap}
.div-leg-item{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--ink2)}
.leg-dot{width:10px;height:10px;border-radius:2px;flex-shrink:0}
.div-score{font-family:'DM Mono',monospace;font-size:28px;font-weight:500;color:var(--navy2);margin-bottom:4px}
.div-summary{font-size:12px;color:var(--mist);margin-bottom:12px}
.risk-badge{display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;padding:3px 9px;border-radius:3px}
.risk-badge .dot{width:6px;height:6px;border-radius:50%}
.risk-LOW{background:var(--low-bg);color:var(--low)}.risk-LOW .dot{background:var(--low)}
.risk-MEDIUM{background:var(--medium-bg);color:var(--medium)}.risk-MEDIUM .dot{background:var(--medium)}
.risk-HIGH{background:var(--high-bg);color:var(--high)}.risk-HIGH .dot{background:var(--high)}
.risk-CRITICAL{background:var(--critical-bg);color:var(--critical)}.risk-CRITICAL .dot{background:var(--critical)}
.alert-list{display:flex;flex-direction:column;gap:8px}
.alert-row{background:var(--white);border:1px solid var(--border);border-radius:8px;padding:12px 16px;display:flex;align-items:flex-start;gap:12px}
.alert-row.crit{border-left:3px solid var(--critical)}.alert-row.high{border-left:3px solid var(--high)}.alert-row.med{border-left:3px solid #2d5be3}
.ar-title{font-size:13px;font-weight:600;color:var(--ink);line-height:1.4;margin-bottom:4px}
.ar-meta{font-size:11px;color:var(--mist);display:flex;gap:10px;flex-wrap:wrap}
.ar-meta strong{color:var(--steel)}
.ar-precis{font-size:12px;color:var(--ink2);line-height:1.55;margin-top:5px}
.watchlist-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px}
.wl-card{background:var(--white);border:1px solid var(--border);border-radius:8px;padding:14px 16px}
.wl-term{font-size:12px;font-weight:700;color:var(--navy2);margin-bottom:8px;display:flex;align-items:center;justify-content:space-between}
.wl-count{font-family:'DM Mono',monospace;font-size:18px;font-weight:500;color:var(--critical);line-height:1;margin-bottom:2px}
.wl-count.zero{color:var(--low)}
.wl-hit{font-size:11px;color:var(--ink2);padding:4px 0;border-bottom:1px solid var(--paper);line-height:1.4}
.wl-hit:last-child{border-bottom:none}
.filter-bar{display:flex;gap:10px;align-items:center;margin-bottom:20px;flex-wrap:wrap}
.filter-bar label{font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--mist)}
.fi{padding:7px 10px;border:1px solid var(--border);border-radius:6px;font-size:12px;color:var(--ink);font-family:'DM Sans',sans-serif;background:var(--white)}
.btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;border:1px solid var(--border);background:var(--white);color:var(--ink);font-family:'DM Sans',sans-serif;transition:all 0.15s;text-decoration:none}
.btn:hover{border-color:var(--navy2);background:var(--blue-pale);color:var(--navy2)}
.btn-navy{background:var(--navy2);color:#fff;border-color:var(--navy2)}
.btn-navy:hover{background:var(--navy)}
.loading{color:var(--mist);font-size:13px;padding:20px;text-align:center}
.error{color:var(--critical);font-size:12px;padding:12px;background:var(--critical-bg);border-radius:6px}
.empty{font-size:13px;color:var(--mist);padding:20px;text-align:center}
.portal-time{font-size:11px;color:var(--mist);text-align:right;margin-bottom:20px}
@media print{.topbar,.filter-bar{display:none!important}body{background:#fff!important}.portal-body{padding:20px!important;max-width:100%!important}.alert-row,.wl-card,.traj-card,.stat-card{page-break-inside:avoid}}
</style>
</head>
<body>
<nav class="topbar">
  <a href="/dashboard" class="topbar-brand">
    <svg width="22" height="26" viewBox="0 0 72 84" fill="none">
      <path d="M36 3 L66 14 L66 40 C66 58 36 72 36 72 C36 72 6 58 6 40 L6 14 Z" fill="#0d1e3a" stroke="#3a5070" stroke-width="2" stroke-linejoin="round"/>
      <path d="M12 32 C18 20 54 20 60 32 C54 44 18 44 12 32 Z" fill="none" stroke="#4a90c8" stroke-width="2.5"/>
      <circle cx="36" cy="32" r="7" fill="none" stroke="#4a90c8" stroke-width="2.5"/>
      <circle cx="36" cy="32" r="3" fill="#4a90c8"/>
    </svg>
    <div><span class="brand-text">VIGINOTE</span><span class="brand-sub">Intelligence Portal</span></div>
  </a>
  <span class="client-badge" id="client-name">Loading…</span>
  <a href="/dashboard" class="nav-link">News Studio</a>
  <a href="/assessment" class="nav-link">Assessment</a>
  <a href="/digest" class="nav-link">Digest</a>
  <button type="button" class="btn" onclick="window.print()">⬇ Export PDF</button>
</nav>
<div class="portal-body">
  <div class="portal-time" id="portal-time"></div>
  <div class="filter-bar">
    <label>Window</label>
    <select class="fi" id="hours-fi"><option value="24">24h</option><option value="48">48h</option><option value="168" selected>7 days</option><option value="336">2 weeks</option></select>
    <label>Min score</label>
    <select class="fi" id="score-fi"><option value="4">4+</option><option value="5" selected>5+</option><option value="7">7+ High</option></select>
    <button type="button" class="btn btn-navy" onclick="loadAll()">↺ Refresh</button>
  </div>
  <div class="stats-strip">
    <div class="stat-card"><div class="sc-label">Total Alerts</div><div class="sc-val" id="st-total">—</div><div class="sc-sub">selected period</div></div>
    <div class="stat-card"><div class="sc-label">Critical</div><div class="sc-val" id="st-crit" style="color:var(--critical)">—</div><div class="sc-sub">score ≥ 8</div></div>
    <div class="stat-card"><div class="sc-label">Regions Active</div><div class="sc-val" id="st-regions">—</div><div class="sc-sub">with alerts</div></div>
    <div class="stat-card"><div class="sc-label">Diversity Score</div><div class="sc-val" id="st-diversity">—</div><div class="sc-sub">local source %</div></div>
    <div class="stat-card"><div class="sc-label">Watchlist Hits</div><div class="sc-val" id="st-watchlist" style="color:var(--high)">—</div><div class="sc-sub">this period</div></div>
  </div>
  <div class="section"><div class="section-head"><span class="section-title">Risk Trajectory</span><span class="section-meta" id="traj-meta">vs. prior period</span></div><div class="traj-grid" id="traj-grid"><div class="loading">Loading trajectory…</div></div></div>
  <div class="section"><div class="section-head"><span class="section-title">Source Diversity Score</span><span class="section-meta">Intelligence source breakdown</span></div><div class="diversity-wrap" id="diversity-wrap"><div class="loading">Loading diversity data…</div></div></div>
  <div class="section" id="watchlist-section"><div class="section-head"><span class="section-title">Watchlist Monitor</span><span class="section-meta" id="wl-meta">Your tracked keywords</span></div><div class="watchlist-grid" id="watchlist-grid"><div class="loading">Checking watchlist…</div></div></div>
  <div class="section"><div class="section-head"><span class="section-title">Intelligence Feed</span><span class="section-meta" id="alerts-meta"></span></div><div class="alert-list" id="alert-list"><div class="loading">Loading alerts…</div></div></div>
</div>
<script>
const API=window.location.origin;
const CFG=__CLIENT_CONFIG__;
document.getElementById('client-name').textContent=CFG.client+' Portal';
document.getElementById('portal-time').textContent='Generated: '+new Date().toLocaleString('en-GB',{weekday:'long',day:'numeric',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'UTC'})+' UTC';
function riskBadge(lvl){const l=(lvl||'MEDIUM').toUpperCase();return`<span class="risk-badge risk-${l}"><span class="dot"></span>${l}</span>`}
function sevClass(score,crit){if(crit||score>=10)return'crit';if(score>=7)return'high';return'med'}
function fmtTime(iso){try{return new Date(iso).toLocaleString('en-GB',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit',timeZone:'UTC'})+' UTC'}catch(e){return iso||''}}
async function loadTrajectory(hours){
  const grid=document.getElementById('traj-grid');
  try{
    let url=`${API}/analytics/trajectory?days=${Math.round(hours/24)||7}`;
    if(CFG.region)url+=`&region=${CFG.region}`;
    const r=await fetch(url);const d=await r.json();
    const regions=d.regions||[];
    document.getElementById('traj-meta').textContent=`${d.period_days}d vs prior ${d.period_days}d`;
    if(!regions.length){grid.innerHTML='<div class="empty">No trajectory data yet</div>';return}
    const icons={IMPROVING:'↑',STABLE:'→',DETERIORATING:'↓'};
    grid.innerHTML=regions.map(reg=>`<div class="traj-card"><div class="tc-region">${(reg.region||'').replace(/_/g,' ')}</div><div class="tc-traj traj-${reg.trajectory}">${icons[reg.trajectory]||'→'} ${reg.trajectory}</div><div class="tc-stats"><span>This: <strong>${reg.this_period.alerts} alerts (avg ${reg.this_period.avg_score})</strong></span><span>Prior: <strong>${reg.prior_period.alerts} alerts</strong></span></div>${reg.alert_change!==0?`<div style="font-size:11px;margin-top:4px;color:${reg.alert_change>0?'var(--critical)':'var(--low)'}">${reg.alert_change>0?'+':''}${reg.alert_change} vs prior period</div>`:''}</div>`).join('');
  }catch(e){grid.innerHTML=`<div class="error">Trajectory error: ${e.message}</div>`}
}
async function loadDiversity(hours){
  const wrap=document.getElementById('diversity-wrap');
  try{
    let url=`${API}/analytics/diversity?hours=${hours}`;
    if(CFG.region)url+=`&region=${CFG.region}`;
    const r=await fetch(url);const d=await r.json();
    if(d.error){wrap.innerHTML=`<div class="error">${d.error}</div>`;return}
    const b=d.breakdown||{};const lp=b.local_specialist?.pct||0;const rp=b.regional?.pct||0;const wp=b.wire?.pct||0;
    document.getElementById('st-diversity').textContent=d.diversity_score||0;
    wrap.innerHTML=`<div class="div-score">${d.diversity_score||0}<span style="font-size:16px;color:var(--mist)">/100</span></div><div class="div-summary">${d.summary||''}</div><div class="div-bar"><div class="div-seg local" style="width:${lp}%"></div><div class="div-seg regional" style="width:${rp}%"></div><div class="div-seg wire" style="width:${wp}%"></div></div><div class="div-legend"><div class="div-leg-item"><div class="leg-dot" style="background:#1a7a4a"></div>Local/Specialist ${lp}% (${b.local_specialist?.count||0})</div><div class="div-leg-item"><div class="leg-dot" style="background:#2d5be3"></div>Regional ${rp}% (${b.regional?.count||0})</div><div class="div-leg-item"><div class="leg-dot" style="background:#d0d8e8"></div>Wire ${wp}% (${b.wire?.count||0})</div></div>${d.top_sources?.length?`<div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border)"><div style="font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--mist);margin-bottom:8px">Top Sources</div><div style="display:flex;flex-wrap:wrap;gap:6px">${d.top_sources.map(s=>`<span style="font-size:11px;padding:2px 8px;border-radius:3px;border:1px solid var(--border);color:var(--steel)">${s.domain} <strong style="color:var(--ink2)">${s.count}</strong></span>`).join('')}</div></div>`:''}`;
  }catch(e){wrap.innerHTML=`<div class="error">Diversity error: ${e.message}</div>`}
}
async function loadWatchlist(hours){
  const grid=document.getElementById('watchlist-grid');
  try{
    const r=await fetch(`${API}/watchlist/check?hours=${hours}`);const d=await r.json();
    if(d.note){grid.innerHTML=`<div class="empty">${d.note}</div>`;document.getElementById('st-watchlist').textContent='—';return}
    const total=d.total_hits||0;document.getElementById('st-watchlist').textContent=total;
    document.getElementById('wl-meta').textContent=`${(d.watchlist||[]).length} tracked terms · ${hours}h window`;
    if(!total){grid.innerHTML='<div class="empty">No watchlist hits in this period</div>';return}
    grid.innerHTML=(d.watchlist||[]).map(term=>{const hits=(d.matches||{})[term]||[];return`<div class="wl-card"><div class="wl-term"><span>${term.toUpperCase()}</span>${riskBadge(hits.length>=3?'HIGH':hits.length>=1?'MEDIUM':'LOW')}</div><div class="wl-count ${hits.length===0?'zero':''}">${hits.length}</div><div style="font-size:10px;color:var(--mist);margin-bottom:8px">alert${hits.length!==1?'s':''} matched</div>${hits.slice(0,3).map(h=>`<div class="wl-hit">${h.title||''}</div>`).join('')}${hits.length>3?`<div style="font-size:10px;color:var(--mist);margin-top:4px">+${hits.length-3} more</div>`:''}</div>`}).join('');
  }catch(e){grid.innerHTML=`<div class="error">Watchlist error: ${e.message}</div>`}
}
async function loadAlerts(hours,score){
  const list=document.getElementById('alert-list');
  try{
    let url=`${API}/alerts?hours=${hours}&min_score=${score}&limit=30`;
    if(CFG.region)url+=`&region=${CFG.region}`;
    if(CFG.location)url+=`&keyword=${encodeURIComponent(CFG.location)}`;
    const r=await fetch(url);const d=await r.json();const alerts=d.alerts||[];
    document.getElementById('st-total').textContent=alerts.length;
    document.getElementById('st-crit').textContent=alerts.filter(a=>a.is_critical||a.score>=10).length;
    document.getElementById('st-regions').textContent=new Set(alerts.map(a=>a.region)).size;
    document.getElementById('alerts-meta').textContent=`${alerts.length} alerts · ${hours}h window`;
    if(!alerts.length){list.innerHTML='<div class="empty">No alerts in this period</div>';return}
    list.innerHTML=alerts.map(a=>{const ents=a.entities||{};const locs=(ents.locs||ents.locations||[]).slice(0,2).join(', ');return`<div class="alert-row ${sevClass(a.score,a.is_critical)}"><div style="flex:1"><div class="ar-title">${a.title||''}</div>${a.precis?`<div class="ar-precis">${a.precis}</div>`:''}<div class="ar-meta" style="margin-top:6px"><span>${(a.region||'').replace(/_/g,' ')}</span><span><strong>${a.source_domain||a.source_dom||''}</strong></span><span>Score ${a.score}</span>${locs?`<span>📍 ${locs}</span>`:''}</div></div><div style="flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;gap:6px">${riskBadge(a.is_critical||a.score>=10?'CRITICAL':a.score>=7?'HIGH':a.score>=5?'MEDIUM':'LOW')}${a.url?`<a href="${a.url}" target="_blank" rel="noopener" style="font-size:11px;color:var(--navy2);font-weight:600;text-decoration:none">Report →</a>`:''}</div></div>`}).join('');
  }catch(e){list.innerHTML=`<div class="error">Alerts error: ${e.message}</div>`}
}
async function loadAll(){
  const hours=parseInt(document.getElementById('hours-fi').value)||168;
  const score=parseInt(document.getElementById('score-fi').value)||5;
  await Promise.all([loadTrajectory(hours),loadDiversity(hours),loadWatchlist(hours),loadAlerts(hours,score)]);
}
loadAll();
setInterval(loadAll,900000);
</script>
</body>
</html>
